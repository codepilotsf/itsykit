class Itsy < Formula
  desc "Plain HTML websites with inline admin editing"
  homepage "https://fleacms.com"
  version "@VERSION@"

  on_macos do
    on_arm do
      url "@BASE@/flea-darwin-arm64"
      sha256 "@ARM_SHA@"
    end
    on_intel do
      url "@BASE@/flea-darwin-amd64"
      sha256 "@INTEL_SHA@"
    end
  end

  def install
    binary = Hardware::CPU.arm? ? "flea-darwin-arm64" : "flea-darwin-amd64"
    bin.install binary => "itsy"
    bin.install_symlink "itsy" => "flea"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/itsy version")
    system bin/"itsy", "new", "example", "--skip-git"
    cd "example" do
      assert_match "Valid local project: Example", shell_output("#{bin}/itsy status")
    end
  end
end
