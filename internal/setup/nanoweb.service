[Unit]
Description=Nanoweb server
After=network.target

[Service]
Type=exec
User=nanoweb
Group=nanoweb
ExecStart=/usr/local/bin/nanoweb-server -config /etc/nanoweb/server.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
WorkingDirectory=/var/lib/nanoweb
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nanoweb
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027

[Install]
WantedBy=multi-user.target
